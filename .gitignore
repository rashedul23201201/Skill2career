# ==============================================================================
# SKILL2CAREER - Master .gitignore
# Prevents accidental commits of credentials, caches, environments, and local build artifacts.
# ==============================================================================

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.env
*.env.local

# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual Environments
.venv/
venv/
ENV/
env/
.env/
env.bak/
venv.bak/

# Testing & Code Coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage/
*.cover
nosetests.xml
*.mo
*.pot

# Logs & Temporary Files
*.log
logs/
*.tmp
*.temp
*.bak

# Node & Frontend Dependencies
node_modules/
frontend/node_modules/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Frontend Build & Production Outputs
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.vite/
frontend/.vite/
*.local

# IDEs, Code Editors & OS Files
.idea/
.vscode/
*.swp
*.swo
*.sw?
*~
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
Desktop.ini
*.suo
*.user
*.userosscache
*.sln.docstates

# Database & SQLite Artifacts
*.sqlite3
*.sqlite
*.db
*.sql.bak
*.sql.dump

# Documentation Assets, UI Design Mockups & Archives
docs/
*.zip
*.tar.gz
*.rar

# Uploads
uploads/
**/uploads/

# AI Agent & Local IDE Metadata
.gemini/
.agents/
.system_generated/
scratch/
