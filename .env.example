# Application Environment
APP_NAME=SKILL2CAREER
APP_ENV=development
DEBUG=true

# Database Configuration (MySQL)
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/skill2career
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=skill2career
MYSQL_USER=skilluser
MYSQL_PASSWORD=skillpassword

# Security & Authentication
JWT_SECRET_KEY=change_this_in_production_super_secret_key_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vite Frontend Environment
VITE_API_BASE_URL=http://localhost:8000/api/v1
